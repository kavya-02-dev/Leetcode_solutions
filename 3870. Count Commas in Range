class Solution {
    public int countCommas(int n) {
        if(n<1000) return 0;
        else if(n<10000){
            return (n-999);
        }
        else if(n<100000){
            return (n-9999)+9000;
        }
        else if(n<1000000){
            return ((n-99999))+90000+9000;
        }
        return 0;
    }
}
