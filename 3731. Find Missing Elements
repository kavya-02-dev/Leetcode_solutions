class Solution {
    public List<Integer> findMissingElements(int[] nums) {
        List<Integer> res=new ArrayList<>();
        Arrays.sort(nums);
        for(int i=0;i<nums.length-1;i++){
            int l=nums[i];
            int r=nums[i+1];
            while(l+1!=r){
                res.add(l+1);
                l++;
            }
        }
        return res;
    }
}
