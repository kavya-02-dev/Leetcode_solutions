class Solution {
    public int countValidPrefixes(String s) {
        
        int a=0;
        int b=0;
        int res=0;
        for(char c:s.toCharArray()){
            
            if(c=='0') a++;
            else b++;
            if(Math.abs(a-b)<=1) res++;
        }
        return res;
    }
}
