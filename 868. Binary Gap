class Solution {
    public int binaryGap(int n) {
        int max=0;
        int c=0;
        boolean flag=false;
        while(n>0){
            if(((n%2)==0) && flag){
                c++;
            }
            else if(n%2==1){
                
                max=Math.max(c,max);
                flag=true;
                c=1;
            }
            n=n/2;
        }

        return max;
    }
}
