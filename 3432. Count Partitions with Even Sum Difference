class Solution {
    public int countPartitions(int[] nums) {
        int right=0;
        int left=nums[0];
        int res=0;
        for(int i=1;i<nums.length;i++) right+=nums[i];
        for(int i=1;i<nums.length;i++){
            
            if((left-right)%2==0) res++;
            left+=nums[i];
            right-=nums[i];
        }
        return res;
    }
}
