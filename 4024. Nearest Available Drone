class Solution {
    public int nearestDrone(int[][] drones, int[] target) {
        int minInd=101;
        int minVal=101;
        for(int i=0;i<drones.length;i++){
            int x=(Math.abs(drones[i][0]-target[0])+Math.abs(drones[i][1]-target[1]));
            if(x<=drones[i][2]){
                if(minVal>x){
                    minVal=x;
                    minInd=i;
                }
                else if(minVal==x && i<minInd) minInd=i;
            }
        }
        if(minInd==101) return -1;
        return minInd;
    }
}
