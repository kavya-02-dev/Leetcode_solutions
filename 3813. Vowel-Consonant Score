class Solution {
    public int vowelConsonantScore(String s) {
        int c=0;
        int v=0;
        for(char x:s.toCharArray()){
            if(x>='a' && x<='z'){
                if(x=='a' || x=='e' || x=='i' || x=='o' ||x=='u') v++;
                else c++;
            }
            
        }
        if(c>0) return (int)Math.floor(v/c);
        return 0;
    }
}
