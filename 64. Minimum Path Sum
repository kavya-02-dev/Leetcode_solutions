class Solution {
    public int minPathSum(int[][] grid) {
        int n=grid.length;
        int m=grid[0].length;
        for(int r=0;r<n;r++){
            for(int c=0;c<m;c++){
                if(r>0 && c>0) grid[r][c]+=Math.min(grid[r-1][c], grid[r][c-1]);
                else if (r>0) grid[r][c]+=grid[r-1][c];
                else if (c>0) grid[r][c]+=grid[r][c-1];
            }
        }
        return grid[n-1][m-1];
    }
}
