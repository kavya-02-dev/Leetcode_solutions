class Solution {
    public int minimumFlips(int n) {
        int x=n;
        int y=0;
        while(x>0){
            y=y<<1;
            if((x&1)!=0) y=y|1;
            x=x>>1;
        }
        int c=0;
        while(y>0 || n>0){
            
            if(((n&1)^(y&1))==1) c++;
            n=n>>1;
            y=y>>1;
        }
        return c;
    }
}
