class Solution {
    public int countSpecialIntegers(int[] nums) {
        int seen[]=new int[101];
        seen[nums[0]]=1;
        int res=1;
        for(int i=1;i<nums.length;i++){
            if(seen[nums[i]]==0){
                seen[nums[i]]=1;
                res++;
            }
            else if(seen[nums[i]]==-1) continue;
            
            else{
                if(nums[i]==nums[i-1]) continue;
                else{
                    seen[nums[i]]=-1;
                    res--;
                }
            }
        }
        
        return res;
    }
}
