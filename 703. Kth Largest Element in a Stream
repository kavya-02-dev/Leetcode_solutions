class KthLargest {
    PriorityQueue<Integer> list=new PriorityQueue<>();
    int x;
    public KthLargest(int k, int[] nums) {
        x=k;
        for(int i=0;i<nums.length;i++){
            add(nums[i]);
            
        }
        
    }
    
    public int add(int val) {
        list.add(val);
        if(list.size()>x){
            list.poll();
        }
        
        
        return list.peek();
    }
}

