class Solution {
    public int countBalls(int lowLimit, int highLimit) {
        Map<Integer, Integer> map=new HashMap<>();
        int maxVal=0;
        for(int i=lowLimit; i<=highLimit;i++){
            int x=SumOfDigits(i);
            map.put(x,map.getOrDefault(x,0)+1);
            if(map.get(x)>maxVal){
                maxVal=map.get(x);
            }
        }
        return maxVal;
    }
    int SumOfDigits (int n){
        int sum=0;
        while(n>0){
            sum+=n%10;
            n=n/10;
        }
        return sum;
    }
}
