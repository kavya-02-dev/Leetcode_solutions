class Solution {
    public int minimumIndex(int[] capacity, int itemSize) {
        int min=101;
        int index=-1;
        for(int i=0;i<capacity.length;i++){
            if(capacity[i]<min && capacity[i]>=itemSize){
                min=capacity[i];
                index=i;
            }
        }
        return index;
    }
}
