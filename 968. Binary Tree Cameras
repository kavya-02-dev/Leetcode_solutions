/**
 * Definition for a binary tree node.
 * public class TreeNode {
 *     int val;
 *     TreeNode left;
 *     TreeNode right;
 *     TreeNode() {}
 *     TreeNode(int val) { this.val = val; }
 *     TreeNode(int val, TreeNode left, TreeNode right) {
 *         this.val = val;
 *         this.left = left;
 *         this.right = right;
 *     }
 * }
 */
class Solution {
    int camera=0;
    boolean reach=true;
    public int minCameraCover(TreeNode root) {
        int state=postOrder(root);
        if(state==1) camera++;
        
        return camera;
    }
    int postOrder(TreeNode root){
        if(root==null) return 0;
        if(root.left==null && root.right==null) root.val=1;
        
        int left= postOrder(root.left);
        int right=postOrder(root.right);
        
        int x=0;
        if(left==0 || right==0) x=Math.max(right,left);
        else x=Math.min(right,left);
        if(x==3 && root.val!=1){
            
            root.val=1;   
            
        }
        else if(x==2 && root.val!=3){   
            root.val=3; 
        }
        
        
        
        else if(x==1 && root.val!=2){
            
            root.val=2;
            camera++;
            
        }
        
        
        
        return root.val;
        
    }
}
