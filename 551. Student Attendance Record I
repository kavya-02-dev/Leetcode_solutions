class Solution {
    public boolean checkRecord(String s) {
        int a=0;
        
        int row=0;
        for(char c:s.toCharArray()){
            if(c=='A'){
                a++;
                row=0;
                if(a>=2) return false;
                
            }
            else if(c=='L' && row!=0){
                row++;
                if(row>=3) return false;
            }
            else if(c=='L' && row==0){
                
                row=1;
            }
            else row=0;
        }
        return true;
    }
}
