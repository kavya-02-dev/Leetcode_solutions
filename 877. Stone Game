Notice: the input array is even length!
because the player 1 chooses either even/odd scores. so they choose the one with large values and win.
if they chose first element, then player 2 can only choose from even indices. And vice versa.
---------or---------
class Solution {
    Integer dp[][];
    public boolean stoneGame(int[] piles) {
        dp=new Integer[piles.length][piles.length];
        return solve(piles,0,piles.length-1)>=0;
    }
    int solve(int nums[], int i, int j){
        if(i==j){
            return nums[i];
        }
        if(dp[i][j]!=null) return dp[i][j];
    
        int l=nums[i]-solve(nums,i+1,j);
        int r=nums[j]-solve(nums,i,j-1);
        dp[i][j]=Math.max(l,r);
        return dp[i][j];
    }
} o(n²)
