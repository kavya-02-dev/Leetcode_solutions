class Solution {
    public int integerBreak(int n) {
        int c=0;
        int res=1;
        if(n==3) return 2;
        while(n>0){
            if(n==1){
                if(res>=3){
                    res/=3;
                    res*=4;
                    n=0;
                    
                }
                n=0;
                return res;
                
            }
            else if(n==2 && res>=3){
                n=0;
                return res*2;
            }
            else if(n==2 && res<3) return 1;
            res*=3;
            n-=3;
            
        }
        return res;
    }
} 
