/**
 * Definition for a binary tree node.
 * public class TreeNode {
 *     int val;
 *     TreeNode left;
 *     TreeNode right;
 *     TreeNode() {}
 *     TreeNode(int val) { this.val = val; }
 *     TreeNode(int val, TreeNode left, TreeNode right) {
 *         this.val = val;
 *         this.left = left;
 *         this.right = right;
 *     }
 * }
 */
class Solution {
    public List<String> binaryTreePaths(TreeNode root) {
        List<String> paths=new ArrayList<>();
        if(root==null) return paths;
        dfs(root, paths, new StringBuilder());
        return paths;
    }
    static void dfs(TreeNode root, List<String> paths, StringBuilder curr){
        int len=curr.length();
        if(len!=0) curr.append("->"+root.val);
        else curr.append(""+root.val);
        
        if(root.left==null && root.right==null){
            paths.add(curr.toString());
        }
        if(root.left!=null) dfs(root.left, paths, curr);
        if(root.right!=null) dfs(root.right,paths, curr);
        curr.setLength(len);
    }
}
