class Solution {
    public long sumAndMultiply(int n) {
        if(n==0) return 0;
        int x[]=sumOfDigits(n);
        return Math.max((long)x[0]*x[1],0L);
    }
    int[] sumOfDigits(int n){
        int sum=0;
        StringBuilder temp=new StringBuilder();
        while(n>0){
            int y=n%10;
            if(y!=0){
                temp.append(y);
            }
            sum+=n%10;
            n/=10;
        }
        int x=(temp.length()==0)?0:Integer.parseInt(temp.reverse().toString());
        return new int[]{sum,x};
    }
}
