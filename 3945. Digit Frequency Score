class Solution {
    public int digitFrequencyScore(int n) {
        int []freq=new int[10];
        int res=0;
        int m=n;
        while(m!=0){
            freq[m%10]++;
            m/=10;
        }
        for(int i=0;i<10;i++){
            res+=(i*freq[i]);
        }
        return res;
    }
}
