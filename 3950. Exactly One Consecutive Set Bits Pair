class Solution {
    public boolean consecutiveSetBits(int n) {
        boolean flag=false;
        int c=0;
        int max=0;
        int x=0;
        while(n>0){
            if((n&1)==0){
                if(c>max) max=c;
                if(c==2) x++;
                c=0;
                flag=false;
                
            }
            else{
                c++;
                flag=true;
            }
            
            
            n=n>>1;
        }
        if(c>max) max=c;
        if(c==2) x++;
        if(max==2 && x==1 )return true;
        return false;
    }
}
