class Solution {
    public int trap(int[] height) {
        int l=0;
        int r=height.length-1;
        int lmax=0;
        int rmax=height.length-1;
        int res=0;
        while(l<r){
            if(height[l]<height[r]){
                if(height[l]>=height[lmax]){
                    lmax=l;
                }
                else{
                    res+=height[lmax]-height[l];
                }
                l++;
            }
            else{
                if(height[r]>=height[rmax]){
                    rmax=r;
                }
                else{
                    res+=height[rmax]-height[r];
                }
                r--;
            }
            
            
        }
        return res;
    }
}
