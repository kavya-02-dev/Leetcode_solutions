class Solution {
    public long removeZeros(long n) {
        StringBuilder temp=new StringBuilder();
        while(n>0){
            long y=n%10;
            if(y!=0){
                temp.append(y);
            }
            n/=10;
            
        }
        return (temp.length()==0)?0:Long.parseLong(temp.reverse().toString()); 
    }
}
