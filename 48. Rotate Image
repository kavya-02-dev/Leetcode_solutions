class Solution {
    public void rotate(int[][] matrix) {
        int n=matrix.length;
        for( int r=0;r<n;r++){
            for(int c=r;c<n;c++){
                if(r==c) continue;
                matrix[r][c]=matrix[r][c]^matrix[c][r];
                matrix[c][r]=matrix[r][c]^matrix[c][r];
                matrix[r][c]=matrix[r][c]^matrix[c][r];
            }
        }
        for( int r=0;r<n;r++){
            int left=0;
            int right=n-1;
            while(left<right){
                
                matrix[r][left]=matrix[r][left]^matrix[r][right];
                matrix[r][right]=matrix[r][left]^matrix[r][right];
                matrix[r][left]=matrix[r][left]^matrix[r][right];
                left++;
                right--;

            }
        }
    }
}
