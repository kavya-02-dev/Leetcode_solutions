class Solution {
    public long maxAlternatingSum(int[] nums) {
        for(int i=0;i<nums.length;i++){
            nums[i]=Math.abs(nums[i]);
        }
        Arrays.sort(nums);
        long first=0;
        long second=0;
        int i=0;
        for( i=0;i<nums.length/2;i++){
            first+=nums[i]*nums[i];
        }
        for( i=i;i<nums.length;i++){
            second+=nums[i]*nums[i];
        }
        return (long)(second-first);
    }
}
