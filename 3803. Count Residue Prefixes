class Solution {
    public int residuePrefixes(String s) {
        int freqs=0;
        int res=0;
        int freq[]=new int[26];
        for(int i=0;i<s.length();i++){
            if(freq[s.charAt(i)-'a']==0){
               freq[s.charAt(i)-'a']=1;
               freqs++; 
            }
            if(freqs==((i+1)%3)) res++;
        }
        return res;
        
    }
}
