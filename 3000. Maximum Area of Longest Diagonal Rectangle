class Solution {
    public int areaOfMaxDiagonal(int[][] dimensions) {
        double a[]=new double[dimensions.length];
        int b[]=new int[dimensions.length];
        int i=0;
        double maxDiag=0;
        int maxArea=0;
        boolean check=false;
        int maxDA=0;
        for(int[] x: dimensions){
            a[i]=Math.sqrt((x[0]*x[0])+(x[1]*x[1]));
            b[i]=x[0]*x[1];
            if(maxDiag<a[i]){
                maxDiag=a[i];
                maxArea=b[i];
                maxDA=b[i];
                check=false;
            }
            else if(maxDiag==a[i]){
                maxArea=(maxArea>b[i])?maxArea:b[i];
                check=true;
            }
        }
        if(check) return maxArea;
        return maxDA;
    }
}
