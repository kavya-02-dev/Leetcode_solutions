class Solution {
    public int findSpecialInteger(int[] arr) {
        double count=1.0;
        for(int i=1;i<arr.length;i++){
            if(arr[i]!=arr[i-1]){
                if(((count/arr.length)*100)>25) return arr[i-1];
                count=1;
            }
            
            else count++;
        }
        if((count/arr.length)*100>25) return arr[arr.length-1];
        return -1;
    }
}
