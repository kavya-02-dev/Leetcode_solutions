class Solution {
    public int dominantIndices(int[] nums) {
        int res=0;
        double sum=(double)nums[nums.length-1];
        if(nums.length==1) return 0;
        
        for(int i=nums.length-2;i>=0;i--){
            if((sum/(nums.length-1-i))<nums[i]){
                res++;
                
            }
            sum+=nums[i];
            
        }
        return res;
    }
}
