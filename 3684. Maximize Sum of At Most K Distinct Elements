class Solution {
    public int[] maxKDistinct(int[] nums, int k) {
        TreeSet<Integer> set=new TreeSet<>();
        for(int num: nums) set.add(num);
        int n=Math.min(k,set.size());
        int res[]=new int[n];
        for(int i=0;i<n;i++) res[i]=set.pollLast();
        return res;
    }
}
