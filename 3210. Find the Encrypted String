class Solution {
    public String getEncryptedString(String s, int k) {
        if(k==0) return s;
        StringBuilder res=new StringBuilder();
        k=k%s.length();
        for(int i=k;i<s.length();i++){
            res.append(s.charAt(i));
        }
        for(int i=0;i<k;i++){
            res.append(s.charAt(i));
        }
        return res.toString();
    }
}
