/**
 * Definition for a binary tree node.
 * public class TreeNode {
 *     int val;
 *     TreeNode left;
 *     TreeNode right;
 *     TreeNode() {}
 *     TreeNode(int val) { this.val = val; }
 *     TreeNode(int val, TreeNode left, TreeNode right) {
 *         this.val = val;
 *         this.left = left;
 *         this.right = right;
 *     }
 * }
 */
class Solution
{
    public boolean hasPathSum(TreeNode root, int targetSum)

    {
        return height(root, 0, targetSum);
    }
    static boolean height(TreeNode root, int sum, int tar)
    {
        if (root == null) return false;
        sum = sum + root.val;
        if (root.left == null && root.right == null)
        {
            if (sum == tar) return true;
            else return false;
        }

         return height(root.left, sum, tar) || height(root.right, sum, tar);
         


    }
}
