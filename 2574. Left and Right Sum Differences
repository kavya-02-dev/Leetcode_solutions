class Solution {
    public int[] leftRightDifference(int[] nums) {
        int prefix[]=new int[nums.length];
        int res[]=new int[nums.length];
        int p=0;
        int s=0;
        for(int i=0;i<nums.length;i++){
            prefix[i]=p;
            p+=nums[i];
        }
        s=p;
        for(int i=0;i<nums.length;i++){
            s=Math.abs(s-nums[i]);
            res[i]=Math.abs(s-prefix[i]);
        }
        return res;
    }
}
