class Solution {
    public boolean canJump(int[] nums) {
        boolean dp[]=new boolean[nums.length];
        dp[0]=true;
        
        for(int i=0;i<nums.length;i++){
            if(dp[i]==true){
                int j=i+1;
                while(j<=nums[i]+i && j<nums.length){
                    if(dp[j]==false) dp[j]=true;
                    j++;
                }
            }
        }
        return dp[nums.length-1];
    }
}
