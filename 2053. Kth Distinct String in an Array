class Solution {
    public String kthDistinct(String[] arr, int k) {
        Map<String, Integer> map=new HashMap<>();
        for(String s: arr){
            map.put(s,map.getOrDefault(s,0)+1);
        }
        int i=1;
        for(String s: arr){
            if(i>k) return "";
            if(map.get(s)==1){
                if(i==k) return s;
                else i++;
            }
        }
        
        return "";
    }
}
