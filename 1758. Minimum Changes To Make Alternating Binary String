class Solution {
    public int minOperations(String s) {
        int start0=0;
        int start1=0;
        for(int i=0;i<s.length();i++){
            char c=s.charAt(i);
            if(i%2==0){
                start0+=0^(c-'0');
                start1+=1^(c-'0');
            }
            else{
                start0+=1^(c-'0');
                start1+=0^(c-'0');
            }
        }
        return Math.min(start0, start1);
    }
}
