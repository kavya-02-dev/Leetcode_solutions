/**
 * Definition for a binary tree node.
 * public class TreeNode {
 *     int val;
 *     TreeNode left;
 *     TreeNode right;
 *     TreeNode() {}
 *     TreeNode(int val) { this.val = val; }
 *     TreeNode(int val, TreeNode left, TreeNode right) {
 *         this.val = val;
 *         this.left = left;
 *         this.right = right;
 *     }
 * }
 */
class Solution {
    public int findSecondMinimumValue(TreeNode root) {
        Set<Integer> res=new TreeSet<>();
        post(root,res);
        if(res.size()<=1) return -1;
        int i=0;
        for(int x: res) if(i++==1) return x;
        return -1;
    }
    void post(TreeNode root, Set<Integer> res){
        if(root==null) return;
        res.add(root.val);
        post(root.left,res);
        post(root.right,res);
        
    }
}
