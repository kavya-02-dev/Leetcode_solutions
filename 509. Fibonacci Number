class Solution {
    public int fib(int n) {
        if (n==0) return 0;
        if (n==1) return 1;
        int a=0;
        int b=1;
        int i=n;
        int c=a+b;
        while(i>2){
            a=b;
            b=c;
            
            c=a+b;
            i--;
        }
        return c;
    }
}
