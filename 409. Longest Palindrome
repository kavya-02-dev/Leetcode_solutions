class Solution {
    public int longestPalindrome(String s) {
        int freq[]=new int[128];
        for(char i:s.toCharArray()){
            freq[i]++;
        }
        int res=0;
        boolean flag=false;
        for(int x:freq){
            res+=(x/2)*2;
            if(x%2!=0) flag=true;
        }
        
        return flag?res+1:res;
    }
}
