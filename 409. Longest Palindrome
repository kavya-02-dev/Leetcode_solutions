class Solution {
    public int longestPalindrome(String s) {
        Map<Character, Integer> map=new HashMap<>();
        for(int i=0;i<s.length();i++){
            char t=s.charAt(i);
            map.put(t,map.getOrDefault(t,0)+1);
        }
        int res=0;
        
        
        int max=0;
        
        for(int x:map.values()){
            if(x%2==0) res+=x;
            if(x%2!=0){
                if(x>max){
                    if(max!=0) res+=max-1;
                    max=x;
                }
                else res+=x-1;
                
                
            }
        }
        
        return res+max;
    }
}
