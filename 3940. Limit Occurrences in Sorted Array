class Solution {
    public int[] limitOccurrences(int[] nums, int k) {
        if(nums.length==1) return nums;
        List<Integer> res=new ArrayList<>();
        res.add(nums[0]);
        int c=1;
        for(int i=1;i<nums.length;i++){
            if(nums[i-1]==nums[i]){
                c++;
                if(c>k) continue;
                
            }
            else{
                c=1;
            }
            res.add(nums[i]);
        }
        int sol[]=new int[res.size()];
        for(int i=0;i<res.size();i++){
            sol[i]=res.get(i);
        }
        return sol;
    }
}
