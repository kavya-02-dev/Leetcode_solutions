class Solution {
    public boolean checkOnesSegment(String s) {
        boolean flag=false;
        boolean flag2=false;
        for(int i=0; i<s.length(); i++){
            char c=s.charAt(i);
            if(!flag && c=='1'){
                flag=true;
            }
            else if(flag && flag2 && c=='1'){
                return false;
            }
            else if(flag && c=='0'){
                flag2=true;
            }
        }
        return true;
    } 
}
