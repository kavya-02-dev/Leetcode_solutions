class Solution {
    public List<Integer> toggleLightBulbs(List<Integer> bulbs) {
        List<Integer> set=new ArrayList<>();
        boolean []flag=new boolean[101];
        for(int x:bulbs){
            flag[x]=!flag[x];
        }
        for(int i=1;i<101;i++){
            if(flag[i]) set.add(i);
        }
        Collections.sort(set);
        return set;
    }
}
