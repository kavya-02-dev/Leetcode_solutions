class Solution {
    public List<Integer> selfDividingNumbers(int left, int right) {
        List<Integer> res=new ArrayList<>();
        for(int i=left;i<=right;i++){
            int x=i;
            boolean valid=true;
            while(x>0){
                if(x>0 && x<=9){
                    if(i%x!=0){
                        valid=false;
                    }
                    x=x/10;
                }
                else{
                    if((x%10==0) || (i%(x%10)!=0)){
                        x=0;
                        valid=false;
                    }
                    else{
                        x/=10;
                    }
                    
                }
            }
            if(valid) res.add(i);
        }
        
        return res;
    }
}
