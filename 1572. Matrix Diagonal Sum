class Solution {
    public int diagonalSum(int[][] mat) {
        int r=mat.length;
        int sum=0;
        if(r==1) return mat[0][0];
        for(int i=0;i<r;i++){
            sum+=mat[i][i];
            sum+=mat[i][r-1-i];
        }
        if((r&1)!=0) sum-=mat[r/2][r/2];
        return sum;
    }
}
