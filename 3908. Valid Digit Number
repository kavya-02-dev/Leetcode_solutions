class Solution {
    public boolean validDigit(int n, int x) {
        int f;
        int y=n;
        if(n<10) f=n;
        else if(n<100) f=n/10;
        else if(n<1000) f=n/100;
        else if(n<10000) f=n/1000;
        else if(n<100000) f=n/10000;
        else f=n/100000;
        if(f!=x){
            while(y>0){
                if(y%10==x) return true;
                y/=10;
            }
        }
        return false;
    }
}
