class Solution {
    public char nextGreatestLetter(char[] letters, char target) {
        if((letters[letters.length-1]<target)||(letters[0]>target)) return letters[0];
        int l=0;
        int r=letters.length-1;
        char res=letters[0];
        while(l<=r){
            int mid=(l+r)/2;
            if(letters[mid]>target){
                res=letters[mid];
                r=mid-1;
            }
            else l=mid+1;
        }
        return res;
    }
}
