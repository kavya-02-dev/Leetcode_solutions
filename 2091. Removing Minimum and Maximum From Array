class Solution {
    public int minimumDeletions(int[] nums) {
        if(nums.length==1) return 1;
        else if(nums.length==2  || nums.length==3) return 2;
        int minInd=-1;
        int maxInd=-1;
        int min=10001;
        int max=-10001;
        for(int i=0;i<nums.length;i++){
            if(nums[i]>max){
                max=nums[i];
                maxInd=i;
            }
            if(nums[i]<min){
                min=nums[i];
                minInd=i;
            }
        }
        int res=0;
        int x=0;
        int y=0;
        if(minInd==maxInd) return Math.min(minInd+1, nums.length-minInd);
        else if(minInd<maxInd){
            x=minInd+1;
            y=maxInd+1;
        }
        else if(minInd>maxInd){
            y=minInd+1;
            x=maxInd+1;
        }
        res=Math.min(y,(nums.length-x)+1);
        res=Math.min(res,x+((nums.length-y)+1));
        return res;
    }
}
