class Solution {
    public List<Integer> preorder(Node root) {
        List<Integer> res=new ArrayList<>();
        preorder(root, res);
        return res;

    }
    void preorder(Node root, List<Integer> res){
        if(root==null) return;
        res.add(root.val);
        for(Node child:root.children){
            
            preorder(child, res);
        }
        
    }
}
