class Solution {
    public int smallestNumber(int n, int t) {
        for(int i=n;i<=101;i++){
            if(prodOfDigit(i)%t==0) return i;
        }
        return 0;
    }
    int prodOfDigit(int n){
        int prod=1;
        while(n>0){
            prod*=n%10;
            n/=10;
        }
        return prod;
    }
}
