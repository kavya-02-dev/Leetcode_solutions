class Solution {
    public int[] sortByBits(int[] arr) {
        PriorityQueue<Integer> pq=new PriorityQueue<>((a,b)->{
            int x=Integer.bitCount(a);
            int y=Integer.bitCount(b);
            if(x!=y) return x - y;
            return a - b;
        });
        for(int i=0;i<arr.length;i++){
            pq.add(arr[i]);
        }
        int res[]=new int [arr.length];
        for(int i=0;i<arr.length;i++){
             
            res[i]=pq.poll();
        }
        return res;
    }
}
