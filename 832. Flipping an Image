class Solution {
    public int[][] flipAndInvertImage(int[][] image) {
        int res[][]=new int[image.length][image[0].length];
        int i=0;
       for (int[] x:image){
           res[i++]=rev(x);
       }
        return res;
    }
    int[] rev(int[] in){
        int i=0;
        int j=in.length-1;
        while(i<=j){
            int temp=in[i];
            in[i]=((in[j]&1)==1)?0:1;
            in[j]=((temp&1)==1)?0:1;
            i++;
            j--;
        }
        return in;
        
    }
    
}
