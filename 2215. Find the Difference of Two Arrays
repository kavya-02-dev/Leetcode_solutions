class Solution {
    public List<List<Integer>> findDifference(int[] nums1, int[] nums2) {
        List<List<Integer>> res=new ArrayList<>();
        res.add(new ArrayList<>());
        res.add(new ArrayList<>());
        
        for(int a:nums1){
            boolean check=false;
            for(int b:nums2){
                if(a==b){
                    check=true;
                    continue;
                }
            }
            if(!check && !res.get(0).contains(a)) res.get(0).add(a);
        }
        for(int a:nums2){
            boolean check=false;
            for(int b:nums1){
                if(a==b){
                    check=true;
                    continue;
                }
            }
            if(!check && !res.get(1).contains(a)) res.get(1).add(a);
        }
        return res;
    }
}
