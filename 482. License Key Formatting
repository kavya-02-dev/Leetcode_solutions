class Solution {
    public String licenseKeyFormatting(String s, int k) {
        StringBuilder res=new StringBuilder();
        int c=0;
        for(int i=s.length()-1;i>=0;i--){
            if(s.charAt(i)!='-'){
                if(c==k){
                    res.append('-');
                    c=0;
                }
                res.append(Character.toUpperCase(s.charAt(i)));
                c++;
            }        
        }
        return res.reverse().toString();
    }
}
