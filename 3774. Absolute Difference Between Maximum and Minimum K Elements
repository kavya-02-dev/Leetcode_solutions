class Solution {
    public int absDifference(int[] nums, int k) {
        Arrays.sort(nums);
        int minSum=0;
        int maxSum=0;
        for(int i=0;i<nums.length;i++){
            if(i<k) minSum+=nums[i];
            if(i>=nums.length-k) maxSum+=nums[i];
        }
        return Math.abs(maxSum-minSum);
    }
}
