class Solution
{
    public TreeNode sortedArrayToBST(int nums[])
    {
        return build(nums, 0, nums.length - 1);
    }
    static TreeNode build(int nums[], int l, int r)
    {
        if (l > r) return null;
        int mid = l + (r - l) / 2;
        TreeNode node = new TreeNode(nums[mid], build(nums, l, mid - 1), build(nums, mid + 1, r));

        return node;

    }
}
