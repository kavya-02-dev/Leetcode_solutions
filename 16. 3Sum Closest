class Solution {
    public int threeSumClosest(int[] nums, int target) {
        int sum=0;
        Arrays.sort(nums);
        int minSum=Integer.MAX_VALUE;
        int minTar=Integer.MAX_VALUE;
        for(int i=0;i<nums.length;i++){
            int l=i+1;
            int r=nums.length-1;
            
            while(l<r){
                sum=nums[i]+nums[l]+nums[r];
                if(Math.abs(sum-target)<minTar){
                    minSum=sum;
                    minTar=Math.abs(sum-target);
                }
                if(sum==target) return target;
                else if(sum<target){
                    l++;
                }
                else r--;
            }
        }
        return minSum;
    }
}
