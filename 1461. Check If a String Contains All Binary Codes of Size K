class Solution {
    public boolean hasAllCodes(String s, int k) {
        int need=1<<k;
        int n=s.length();
        boolean[] seen=new boolean[need];
        int hash=0;
        int c=0;
        int max=need-1;
        for(int i=0;i<n;i++){
            hash=(hash<<1 & max) | s.charAt(i)-'0';
            if(i>=k-1){
                if(!seen[hash]){
                    seen[hash]=true;
                    c++;
                    if(c==need) return true;
                }
            }
        }
        return false;

    }
}
