class Solution {
    public String reverseByType(String s) {
        List<Character> list=new ArrayList<>();
        List<Character> charx=new ArrayList<>();
        StringBuilder res=new StringBuilder();
        
        for(int i=s.length()-1;i>=0;i--){
            char x=s.charAt(i);
            if(x<'a' || x>'z'){
                
                list.add(x);
                
            
            }
            else charx.add(x);
        }
        int j=0;
        int k=0;
        for(int i=0;i<s.length();i++){
            char x=s.charAt(i);
            if(x<'a' || x>'z'){
                
                res.append(list.get(j++));
                
            
            }
            else res.append(charx.get(k++));
        }
        return res.toString();
    }
}
