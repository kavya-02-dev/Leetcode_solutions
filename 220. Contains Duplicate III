class Solution
{
    public boolean containsNearbyAlmostDuplicate(int[] nums, int indexDiff, int valueDiff)
    {
        if (indexDiff <= 0 || valueDiff < 0) return false;
        TreeSet<Long> set = new TreeSet<>(); //should not put Set<> put TreeSet at both places
        for(int i = 0; i < nums.length; i++)
        {
            long x = nums[i]; 
            Long val = set.ceiling(x - valueDiff); // ceiling works only for TreeSet not Set
            if(val!=null && val <= x + valueDiff) // (UP) long can't hold null values. So use Long
            {
                return true;
            }
            set.add(x);
            if (i >= indexDiff)
            {
                set.remove((long)nums[i - indexDiff]); //sliding window removal
            }
        }
        return false;
    }
}
