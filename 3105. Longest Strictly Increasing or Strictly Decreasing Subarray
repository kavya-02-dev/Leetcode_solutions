class Solution {
    public int longestMonotonicSubarray(int[] nums) {
        int max=1;
        int p=nums[0];
        int c=1;
        for(int i=1;i<nums.length;i++){
            if(nums[i]>p) c++;
            else{
                max=Math.max(c,max);
                c=1;
            }
            p=nums[i];
        }
        max=Math.max(c,max);
        p=nums[nums.length-1];
        for(int i=nums.length-2;i>=0;i--){
            if(nums[i]>p) c++;
            else{
                max=Math.max(c,max);
                c=1;
            }
            p=nums[i];
        }
        max=Math.max(c,max);
        return max;
    }
}
