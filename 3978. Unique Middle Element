class Solution {
    public boolean isMiddleElementUnique(int[] nums) {
        if(nums.length==1) return true;
        int x=nums[nums.length/2];
        int c=0;
        for(int i=0;i<nums.length;i++){
            if(nums[i]==x){
                c++;
                if(c>1) return false;
            }
        }
        return true;
    }
}
