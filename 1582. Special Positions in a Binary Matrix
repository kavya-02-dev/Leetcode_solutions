class Solution {
    public int numSpecial(int[][] mat) {
        int c=0;
        int capr[]=new int[mat.length];
        int capc[]=new int[mat[0].length];
        for(int i=0;i<mat.length;i++){
            for(int j=0;j<mat[0].length;j++){
                if(mat[i][j]==1){
                    capr[i]++;
                    capc[j]++;
                }
            }
        }
        for(int i=0;i<mat.length;i++){
            for(int j=0;j<mat[0].length;j++){
                if(mat[i][j]==1 && capr[i]==1 && capc[j]==1){
                    c++;
                }
            }
        }
        return c;
    }
}
